# Backend Fastify API Environment Variables (Render Web Service)
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis & BullMQ Queue (Render Key Value)
REDIS_URL=redis://localhost:6379

# Master Token Encryption Key (64-char Hex: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=

# Google OAuth & APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PAGESPEED_API_KEY=

# Resend Transactional Email
RESEND_API_KEY=
EMAIL_FROM=SiteScope <notifications@sitescope.io>

# Backblaze B2 Private Storage
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=

# Razorpay Subscriptions (Test Mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
