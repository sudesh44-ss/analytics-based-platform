# Frontend Public Environment Variables (Next.js)
# WARNING: All NEXT_PUBLIC_* variables are bundled into client-side JavaScript.
# NEVER place secret API keys, service role credentials, or private keys here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
