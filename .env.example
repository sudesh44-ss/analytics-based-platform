# SiteScope Monorepo Root Environment Configuration Template
# Copy to .env for local development with scripts and database tools.
# DO NOT commit real secrets or production credentials to this file.

NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
# Used by scripts/migrate.js and local database utilities
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sitescope
SUPABASE_DB_URL=

# Redis Connection
REDIS_URL=redis://localhost:6379

# Local Service URLs
API_PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
